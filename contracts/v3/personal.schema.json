{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nddev.ai/schemas/nddev-device-sync/v3/personal.schema.json",
  "title": "NDS original personal context and device inventory",
  "description": "An authenticated personal-space observation, not a grant. Personal space identity is the stable principal ID; existing tenant/user storage bindings, device keys and ciphertext remain unchanged. Organization selection and shared resources are outside this profile.",
  "oneOf": [
    {
      "$ref": "#/$defs/PersonalDeviceList"
    },
    {
      "$ref": "#/$defs/PersonalDevicePolicy"
    },
    {
      "$ref": "#/$defs/DevicePolicyUpdate"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ],
  "$defs": {
    "PersonalSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "personal"
          ]
        },
        "id": {
          "$ref": "https://nddev.ai/schemas/nddev-device-sync/v2/control-plane.schema.json#/$defs/Identifier"
        }
      }
    },
    "PersonalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "space"
      ],
      "properties": {
        "principal_id": {
          "$ref": "https://nddev.ai/schemas/nddev-device-sync/v2/control-plane.schema.json#/$defs/Identifier"
        },
        "space": {
          "$ref": "#/$defs/PersonalSpace"
        }
      },
      "description": "The server derives principal_id and space.id from the same authenticated user; consumers must require equality to their captured initiating principal. This does not expose session credentials or legacy storage ownership."
    },
    "PersonalDeviceList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "devices",
        "next_cursor"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/PersonalContext"
        },
        "devices": {
          "$ref": "https://nddev.ai/schemas/nddev-device-sync/v2/control-plane.schema.json#/$defs/DeviceList/properties/devices",
          "maxItems": 32
        },
        "next_cursor": {
          "$ref": "https://nddev.ai/schemas/nddev-device-sync/v2/control-plane.schema.json#/$defs/DeviceList/properties/next_cursor"
        }
      }
    },
    "Error": {
      "$ref": "https://nddev.ai/schemas/nddev-device-sync/v2/control-plane.schema.json#/$defs/Error"
    },
    "Device": {
      "$ref": "https://nddev.ai/schemas/nddev-device-sync/v2/control-plane.schema.json#/$defs/Device"
    },
    "DevicePurpose": {
      "title": "DevicePurpose",
      "type": "string",
      "enum": [
        "server-hosting",
        "server-dev-desktop",
        "server-desktop",
        "build-dev-desktop",
        "dev-desktop",
        "desktop"
      ],
      "description": "Intended workload profile from the architecture's device placement table. Describes intent only; never a grant."
    },
    "ControlMode": {
      "title": "ControlMode",
      "type": "string",
      "enum": [
        "fullauto",
        "manual"
      ],
      "description": "Authenticated device action-admission mode (ADR 0018). Fullauto admits supported system tools without an NDS checklist; manual keeps the owner's explicit module configuration."
    },
    "PolicyRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "DevicePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "purposes",
        "revision"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/ControlMode"
        },
        "purposes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DevicePurpose"
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        },
        "revision": {
          "$ref": "#/$defs/PolicyRevision"
        }
      }
    },
    "PersonalDevicePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "device_id",
        "policy"
      ],
      "description": "Current policy of one device owned by the authenticated principal. Device identity, key and proof are unaffected by policy revisions.",
      "properties": {
        "context": {
          "$ref": "#/$defs/PersonalContext"
        },
        "device_id": {
          "$ref": "https://nddev.ai/schemas/nddev-device-sync/v2/control-plane.schema.json#/$defs/Identifier"
        },
        "policy": {
          "$ref": "#/$defs/DevicePolicy"
        }
      }
    },
    "DevicePolicyUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_revision",
        "mode",
        "purposes"
      ],
      "description": "Compare-and-set replacement by the device owner. Widening manual into fullauto requires a recent sign-in.",
      "properties": {
        "expected_revision": {
          "$ref": "#/$defs/PolicyRevision"
        },
        "mode": {
          "$ref": "#/$defs/ControlMode"
        },
        "purposes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DevicePurpose"
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        }
      }
    }
  }
}
